{
  "name": "mimir",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "api:dev": "pnpm --filter @mimir/api start:dev",
    "web:dev": "pnpm --filter @mimir/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:ui": "pnpm --filter @mimir/web test:e2e"
  }
}
